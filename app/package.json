{
  "name": "guided-health-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Guided Health AI (GHAI) — proactive health companion web app",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "score:check": "node scripts/check-wearable-score.mjs && node scripts/check-bloodwork-score.mjs",
    "bloodwork:check": "node scripts/check-bloodwork-score.mjs",
    "emails:build": "node scripts/apply-auth-email-templates.mjs",
    "emails:apply": "node scripts/apply-auth-email-templates.mjs --apply",
    "emails:configure-resend": "node scripts/configure-resend-auth-email.mjs",
    "emails:preview": "vite --open /emails/preview.html"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.8"
  }
}
