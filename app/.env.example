# Copy to .env.local and fill in.
#
# NOTE: every VITE_* value here is compiled into the public browser bundle.
# Only put things here that are safe to publish. Secrets (the Resend API key,
# any AI provider key) belong in Supabase Edge Function secrets — never here.

# --- Supabase ---
# Temporary home: the `ghai` schema inside the MetabolicHealth project.
# Isolated in its own schema so it can be lifted into a dedicated project later.
VITE_SUPABASE_URL=https://pmqxkdqkqxhbrymeerem.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_SCHEMA=ghai

# Deployed app URL — used as the password-reset link's return target. Must match the
# URL users actually load the app from. Also add the same URL to Supabase →
# Authentication → URL Configuration (Site URL + Redirect URLs) for reset to complete.
VITE_SITE_URL=https://pocketdoc-dashboard.onrender.com

# AI gateway (OpenAI, via server-side proxy).
# AI calls go through the `ghai-ai` Supabase Edge Function, which holds the
# OpenAI key as a secret (OPENAI_API_KEY). No API key is ever set in the browser.
# Only the model id is needed client-side.
VITE_AI_MODEL=gpt-4o
