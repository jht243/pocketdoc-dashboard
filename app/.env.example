# Copy to .env.local and fill in.
#
# NOTE: every VITE_* value here is compiled into the public browser bundle.
# Only put things here that are safe to publish. Secrets (the Resend API key,
# any AI provider key) belong in Supabase Edge Function secrets — never here.

# --- Supabase ---
# Temporary home: the `ghai` schema inside the MetabolicHealth project.
# Isolated in its own schema so it can be lifted into a dedicated project later.
VITE_SUPABASE_URL=https://pmqxkdqkqxhbrymeerem.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_SCHEMA=ghai

# AI gateway. Defaults to Anthropic direct, which only works inside a sandboxed
# preview (no key is sent from the browser, and we must never ship one there).
# In Phase D this points at our own backend, e.g. http://localhost:8787/api/ai
VITE_AI_ENDPOINT=

# Model id used for every AI call.
VITE_AI_MODEL=claude-sonnet-4-6
